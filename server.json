{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Nishkalkashyap/agentgo",
  "title": "AgentGo",
  "description": "Run Codex and Claude Code on your computer from an MCP client, and track or continue their runs.",
  "repository": {
    "url": "https://github.com/Nishkalkashyap/agentgo",
    "source": "github"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "agentgo-mcp",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "stdio"
        }
      ]
    }
  ]
}
